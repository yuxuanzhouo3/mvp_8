{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "https://www.mornhub.help",
    "frontendDist": "../dist"
  },
  "productName": "SiteHub",
  "version": "1.0.0",
  "identifier": "com.sitehub.app",
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "SiteHub - Your Personal Web Dashboard",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "minWidth": 800,
        "minHeight": 600,
        "url": "https://www.mornhub.help"
      }
    ],
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "www.mornhub.help",
          "windows": ["main"],
          "enableTauriAPI": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  }
}
