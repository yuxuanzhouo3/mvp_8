/* components/sidebar/sidebar.wxss */

/* 遮罩层 */
.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 999;
  transition: all 0.3s ease;
  visibility: hidden;
}

.sidebar-overlay.show {
  background: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

/* 侧边栏 */
.sidebar {
  position: fixed;
  top: 0;
  left: -600rpx; /* 默认隐藏在左侧 */
  bottom: 0;
  width: 560rpx;
  max-width: 85vw;
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
  box-shadow: 2rpx 0 20rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  padding-top: env(safe-area-inset-top);
}

.sidebar.show {
  left: 0; /* 显示时移到可见区域 */
}

/* 返回按钮 */
.back-button {
  position: absolute;
  top: 20rpx;
  top: calc(20rpx + env(safe-area-inset-top));
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(59, 130, 246, 0.2);
  border: 2rpx solid rgba(59, 130, 246, 0.3);
  border-radius: 24rpx;
  transition: all 0.2s ease;
  z-index: 10;
}

.back-button:active {
  background: rgba(59, 130, 246, 0.3);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
  line-height: 1;
}

.back-text {
  font-size: 28rpx;
  color: white;
  font-weight: 500;
}

/* 用户信息区域 */
.user-section {
  padding: 48rpx 32rpx 32rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.1);
}

.user-info,
.guest-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  transition: all 0.2s ease;
}

.user-info:active,
.guest-info:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.98);
}

.user-avatar,
.guest-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
}

.guest-icon {
  font-size: 48rpx;
  color: white;
}

.user-details,
.guest-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name,
.guest-name {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

.user-email,
.guest-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.pro-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-radius: 20rpx;
  align-self: flex-start;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: white;
  font-weight: 600;
}

.pro-icon {
  font-size: 20rpx;
}

/* 菜单区域 */
.menu-section {
  flex: 1;
  padding: 24rpx 16rpx;
  overflow-y: auto;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.03);
  transition: all 0.2s ease;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.98);
}

.menu-item-upgrade {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(217, 119, 6, 0.2) 100%);
  border: 2rpx solid rgba(245, 158, 11, 0.3);
}

.menu-item-upgrade .menu-text {
  color: #fbbf24;
  font-weight: 600;
}

.menu-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: white;
}

.menu-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 300;
}

/* 退出登录区域 */
.logout-section {
  padding: 24rpx 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(255, 255, 255, 0.1);
}

.logout-button {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 16rpx;
  background: rgba(239, 68, 68, 0.12);
  border: 2rpx solid rgba(239, 68, 68, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.logout-button:active {
  transform: scale(0.97);
  background: rgba(239, 68, 68, 0.18);
}

.logout-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #f87171;
  text-align: center;
}
