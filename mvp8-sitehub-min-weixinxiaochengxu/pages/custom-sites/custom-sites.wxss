/* pages/custom-sites/custom-sites.wxss - 自定义网站管理页面样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
  padding: 0;
}

/* ========== 页面头部 ========== */
.header {
  padding: 60rpx 32rpx 20rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
  background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.1);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  color: white;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  color: white;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border-radius: 50%;
  transition: all 0.2s ease;
}

.add-btn:active {
  transform: scale(0.9);
}

.add-icon {
  font-size: 40rpx;
  color: white;
  font-weight: bold;
}

/* ========== 网站列表 ========== */
.sites-section {
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.sites-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.site-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 32rpx;
  transition: all 0.2s ease;
}

.site-item:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.98);
}

.site-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.site-logo {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.site-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.site-name {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 8rpx;
}

.site-url {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 4rpx;
  word-break: break-all;
}

.site-description {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.site-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.edit-btn {
  background: rgba(59, 130, 246, 0.2);
  border: 2rpx solid rgba(59, 130, 246, 0.3);
}

.edit-btn:active {
  background: rgba(59, 130, 246, 0.3);
  transform: scale(0.9);
}

.delete-btn {
  background: rgba(239, 68, 68, 0.2);
  border: 2rpx solid rgba(239, 68, 68, 0.3);
}

.delete-btn:active {
  background: rgba(239, 68, 68, 0.3);
  transform: scale(0.9);
}

.action-icon {
  font-size: 28rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.4;
}

/* ========== 弹窗样式 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: rgba(59, 130, 246, 0.15);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

.modal-close {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.7);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
}

.modal-close:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.9);
}

.modal-body {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: white;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  color: white;
  font-size: 28rpx;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  color: white;
  font-size: 28rpx;
}

.form-textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.1);
}

.btn-cancel {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  color: white;
  font-size: 28rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.btn-cancel:active {
  background: rgba(255, 255, 255, 0.2);
}

.btn-save {
  flex: 1;
  padding: 24rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border: none;
  border-radius: 16rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-save:active {
  transform: scale(0.98);
}

.btn-save.loading {
  opacity: 0.7;
}

.btn-save::after {
  border: none;
}






