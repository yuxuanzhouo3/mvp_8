/* pages/login/login.wxss - 微信登录页面样式 */

.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
  padding: 0;
}

/* ========== 顶部返回按钮 ========== */
.header {
  padding: 60rpx 32rpx 20rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
}

.back-btn {
  display: flex;
  align-items: center;
  width: fit-content;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  color: white;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  color: white;
}

/* ========== 登录区域 ========== */
.login-section {
  padding: 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* 应用信息 */
.app-info {
  margin-bottom: 80rpx;
}

.app-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.app-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ========== 登录内容 ========== */
.login-content {
  width: 100%;
  max-width: 600rpx;
}

.login-desc {
  margin-bottom: 60rpx;
}

.desc-text {
  display: block;
  font-size: 32rpx;
  color: white;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.desc-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  text-align: center;
}

/* 微信登录按钮 */
.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, #07c160 0%, #00ae52 100%);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  transition: all 0.2s ease;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  border: none;
  line-height: 1;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.4);
}


.login-text {
  font-size: 36rpx;
  color: white;
  font-weight: 600;
}

/* 头像预览 */
.temp-avatar-preview {
  margin: 32rpx 0 24rpx;
  display: flex;
  justify-content: center;
}

.preview-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

/* 昵称输入框 */
.nickname-input {
  display: block;
  width: 80%;
  max-width: 420rpx;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  color: white;
  font-size: 32rpx;
  margin: 0 auto 24rpx;
  text-align: center;
}

.nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

/* 确认登录按钮 */
.confirm-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80%;
  max-width: 420rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  margin: 0 auto 32rpx;
  transition: all 0.2s ease;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  border: none;
  line-height: 1;
}

.confirm-login-btn::after {
  border: none;
}

.confirm-login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.login-tips {
  margin-top: 32rpx;
}

.tips-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.4;
}

/* ========== 用户信息展示 ========== */
.user-profile {
  width: 100%;
  max-width: 600rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
}

.user-name {
  font-size: 36rpx;
  color: white;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.login-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 用户功能列表 */
.user-features {
  margin-bottom: 60rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.feature-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.feature-text {
  font-size: 28rpx;
  color: #e2e8f0;
  flex: 1;
}

/* 退出登录按钮 */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 32rpx;
  background: rgba(239, 68, 68, 0.2);
  border: 2rpx solid rgba(239, 68, 68, 0.4);
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.logout-btn:active {
  background: rgba(239, 68, 68, 0.3);
  transform: scale(0.98);
}

.logout-text {
  font-size: 32rpx;
  color: #f87171;
  font-weight: 500;
}

/* ========== 响应式适配 ========== */
@media (max-width: 375px) {
  .login-section {
    padding: 32rpx 40rpx;
  }
  
  .app-icon {
    font-size: 100rpx;
  }
  
  .app-title {
    font-size: 40rpx;
  }
}
